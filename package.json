{
  "name": "ledgerble",
  "version": "1.0.0",
  "description": "Gui for Ledger CLI",
  "main": "main.js",
  "scripts": {
    "start": "npm run bundle && electron .",
    "bundle": "node esbuild.config.mjs",
    "test": "jest",
    "dist": "npm run bundle && electron-builder --mac --arm64"
  },
  "author": "Sean Bridges",
  "license": "Apache-2.0",
  "bin": {
    "ledgerble": "ledgerble.js"
  },
  "build": {
    "appId": "com.github.sbridges.ledgerble",
    "productName": "Ledgerble",
    "mac": {
      "icon": "icons/gerbil.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "extendInfo": {
        "CFBundleLocalizations": [
          "en",
          "de",
          "es",
          "fr",
          "zh-CN",
          "ja",
          "ru",
          "pt",
          "it",
          "nl",
          "ko",
          "pl"
        ]
      }
    },
    "win": {
      "icon": "icons/gerbil.ico",
      "target": [
        "zip",
        "nsis"
      ]
    },
    "linux": {
      "icon": "icons/gerbil.png"
    },
    "files": [
      "main.js",
      "knownKeys.js",
      "preload.js",
      "windowChrome.js",
      "hledger.js",
      "menu.js",
      "i18n.js",
      "index.html",
      "dist/bundle.js",
      "dist/bundle.js.map",
      "icons/**",
      "locales/**",
      "package.json"
    ]
  },
  "dependencies": {
    "moment": "^2.30.1",
    "papaparse": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "settings-store": "^1.4.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "binary-search": "^1.3.6",
    "echarts": "^5.6.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^25.0.1"
  }
}
