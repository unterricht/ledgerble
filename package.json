{
  "name": "ledgerble",
  "version": "0.3.0",
  "description": "Gui for Ledger CLI",
  "main": "main.js",
  "scripts": {
    "start": "npm run bundle && electron .",
    "bundle": "node esbuild.config.mjs",
    "test": "jest",
    "dist": "npm run bundle && electron-builder --mac --arm64"
  },
  "author": "Sean Bridges",
  "license": "Apache-2.0",
  "bin": {
    "ledgerble": "ledgerble.js"
  },
  "build": {
    "appId": "com.github.sbridges.ledgerble",
    "productName": "Ledgerble",
    "mac": {
      "icon": "icons/emblem_library.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "extendInfo": {
        "CFBundleLocalizations": [
          "en",
          "de",
          "es",
          "fr",
          "zh-CN",
          "ja",
          "ru",
          "pt",
          "it",
          "nl",
          "ko",
          "pl"
        ]
      }
    },
    "files": [
      "main.js",
      "knownKeys.js",
      "preload.js",
      "windowChrome.js",
      "hledger.js",
      "menu.js",
      "i18n.js",
      "index.html",
      "dist/bundle.js",
      "dist/bundle.js.map",
      "vendor/**",
      "icons/**",
      "locales/**",
      "package.json"
    ]
  },
  "dependencies": {
    "moment": "^2.30.1",
    "papaparse": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "settings-store": "^1.4.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "binary-search": "^1.3.6",
    "bootstrap": "^4.6.2",
    "currency-symbol-map": "^4.0.4",
    "currencyformatter.js": "^2.2.0",
    "datatables.net-buttons-dt": "^1.6.1",
    "datatables.net-colreorder-dt": "^1.5.2",
    "datatables.net-dt": "^1.10.20",
    "datatables.net-fixedheader-dt": "^3.1.6",
    "datatables.net-responsive-dt": "^2.2.3",
    "datatables.net-scroller-dt": "^2.0.1",
    "echarts": "^5.6.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jquery": "^3.7.1",
    "jsdom": "^25.0.1",
    "numeral": "^2.0.6",
    "popper.js": "^1.16.1",
    "streamjs": "^1.6.4"
  }
}
